# Copy this file to .env.local and fill in the values.

# Set to "demo" to skip Google Sheets entirely (uses fallback aggregate).
# Leave blank (or set to "live") to write to / read from the sheet.
POLL_STORAGE_MODE=demo

# Apps Script Web App URL (the /exec URL you copied after deploying apps_script.gs).
# Required when POLL_STORAGE_MODE != "demo".
APPS_SCRIPT_URL=
